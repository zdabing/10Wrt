#!/bin/sh
# 首次启动自动配置（执行一次后由系统标记自删）
# 只做幂等的 uci 设置，不主动 restart 网络/防火墙服务，
# 避免开机早期 restart 与 netifd/wan 拨号产生时序竞争（导致升级后首次无网络）。
# 服务刷新交给 OpenWrt 后续正常启动流程接管。

# ---- Packet Steering（多队列网卡软中断均衡）----
uci -q get network.globals.packet_steering >/dev/null || \
uci set network.globals.packet_steering='1'

# ---- 时区设为 Asia/Shanghai ----
uci set system.@system[0].timezone='CST-8'
uci set system.@system[0].zonename='Asia/Shanghai'

# ---- LuCI 诊断目标改为国内站点 ----
uci set luci.diag.dns='www.doubao.com'
uci set luci.diag.ping='www.doubao.com'
uci set luci.diag.route='www.doubao.com'

# ---- TCP MSS 钳制（PPPoE MTU 1492 -> MSS 1452）----
# 动态定位 wan 防火墙区域，避免硬编码 zone 索引错位
wan_idx=$(uci show firewall | grep "name='wan'" | cut -d'[' -f2 | cut -d']' -f1 | head -n1)
if [ -n "$wan_idx" ]; then
    uci set firewall.@zone[${wan_idx}].mtu_fix='1'
else
    # 兜底：取最后一个 zone（通常是 wan）
    wan_idx=$(uci show firewall | grep 'zone' | tail -1 | cut -d'[' -f2 | cut -d']' -f1)
    [ -n "$wan_idx" ] && uci set firewall.@zone[${wan_idx}].mtu_fix='1'
fi

# ---- 禁用 LAN 口 IPv6 分配（内网设备不走 v6 撞墙）----
uci set dhcp.lan.ra='disabled'
uci set dhcp.lan.dhcpv6='disabled'
uci set dhcp.lan.ndp='disabled'

# ---- nginx 配置（仅当 nginx 已安装时生效）----
if [ -x /etc/init.d/nginx ]; then
    mkdir -p /www
    cat > /etc/nginx/conf.d/favicon.locations <<'EOCONF'
location = /favicon.ico {
    access_log off;
    log_not_found off;
    return 204;
}
EOCONF

    uci set nginx.global.uci_enable='true'
    uci del nginx._lan 2>/dev/null
    uci del nginx._redirect2ssl 2>/dev/null
    uci add nginx server
    uci rename nginx.@server[-1]='_lan'
    uci set nginx._lan.server_name='_lan'
    uci add_list nginx._lan.listen='80 default_server'
    uci add_list nginx._lan.listen='[::]:80 default_server'
    uci add_list nginx._lan.include='conf.d/*.locations'
    uci set nginx._lan.access_log='off; # logd openwrt'
fi

# ---- PPPoE：保留默认 norelease 行为（ppp.sh 内部会覆盖此设置）----

# ---- 统一提交（不在脚本内 restart 任何服务）----
uci commit

exit 0
