## nf_deaf 打标规则（绕过运营商 DPI 限速）
##
## 背景：外网访问 NAS 上行被运营商限到 5M，而 speedtest.cn 测速上行能跑满，
##       说明运营商对非白名单出向 TCP 流做 DPI 限速，测速站点在白名单内。
## 原理：nf_deaf 内核模块在 TCP 连接早期抢先注入一个伪装成测速的包
##       （GET / Host: www.speedtest.cn，TTL=3 只到运营商 DPI、校验和故意错误
##        远端收不到），让 DPI 误判该连接为测速流量，从而不再限速。
##
## 本文件由 firewall4 自动 include 进 inet/fw4 表（fw4 reload 时 flush 后重载），
## 因此只定义 base chain，不声明 table。
##
## Mark 0xDEA10103 位域含义（kmb21y66/nf_deaf fork）：
##   bits 31-20 = Magic 0xDEA
##   bit  16    = 使用错误的 TCP 校验和（降低注入包对远端的影响）
##   bits 12-8  = 延迟原包 1 jiffy（让伪装包先于真实数据发出）
##   bits 7-0   = 注入包 TTL=3（仅到达运营商 DPI，远端不可见）
##
## 想对某个 IP 取消加速（例如代理节点），在该 IP 后加一条：
##   ip daddr <IP> return

chain nf_deaf_postrouting {
    type filter hook postrouting priority 1; policy accept;

    # 跳过私有/保留地址（仅公网出向流量参与）
    ip daddr {100.64.0.0/10, 0.0.0.0/8, 10.0.0.0/8, 127.0.0.0/8,
              169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.0.2.0/24,
              192.88.99.0/24, 192.168.0.0/16, 198.18.0.0/15, 198.51.100.0/24,
              203.0.113.0/24, 224.0.0.0/4, 240.0.0.0/4} return

    # 已标记的连接不再重复注入（避免每个包都触发一次）
    ct mark 0xDEA10103 return

    # 其余公网 IPv4 TCP 大包（握手后第一个数据包）：标记连接 + 标记包
    # 只处理 IPv4（ip protocol tcp）；IPv6 走 policy accept，不参与
    ip protocol tcp meta length gt 120 ct mark set 0xDEA10103 meta mark set 0xDEA10103 return
}
